# Copy to /opt/familybudget/.env on the VM (chmod 600, owner deploy). Never commit the copy.
DOMAIN=budget.example.com
ACME_EMAIL=you@example.com
# openssl rand -base64 32. Changing it after the first start doesn't change the DB password.
POSTGRES_PASSWORD=
# openssl rand -base64 48 (at least 32 bytes).
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Play subscriptions; optional until Play is set up. The key file goes in
# /opt/familybudget/secrets/ (readable by the container's user).
GOOGLE_PLAY_CREDENTIALS=/run/secrets/familybudget/google-play.json
# The push subscription's OIDC audience and service account (Pub/Sub → Push → Authentication).
GOOGLE_PLAY_PUSH_AUDIENCE=https://budget.example.com/api/v1/webhooks/google-play
GOOGLE_PLAY_PUSH_SERVICE_ACCOUNT=
# Pinned by deploy.sh on every deploy.
API_TAG=latest
WEB_TAG=latest
# Optional: Azure Blob container URL with a write-only SAS; backup.sh uploads each dump there.
BACKUP_CONTAINER_URL=
