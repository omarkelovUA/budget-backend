# Copy to .env (git-ignored); docker compose reads it automatically.
# Google login: OAuth client of type "Web application" in Google Cloud Console with the
# redirect URI http://localhost:4200/login/oauth2/code/google (see README).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Needed on http://localhost, or the browser drops the refresh cookie.
REFRESH_COOKIE_SECURE=false
